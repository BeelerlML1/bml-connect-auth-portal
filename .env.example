# BML CONNECT Authentication Portal - Environment Configuration
# Provide these in Netlify (Site settings > Environment variables) or in your local .env file.
# IMPORTANT: Use ONLY your project URL and public publishable (anon) key.
# NEVER expose or use your Supabase service_role key in frontend code!

VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# Custom scheme for the BML CONNECT Android App deep link (default: bmlconnect)
VITE_APP_DEEP_LINK_SCHEME="bmlconnect"
